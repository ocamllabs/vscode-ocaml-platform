{
  "name": "OCaml Interface",
  "scopeName": "source.ocaml.interface",
  "fileTypes": ["mli", "eliomi"],
  "patterns": [
    { "include": "source.ocaml#directives" },
    { "include": "source.ocaml#comments" },
    { "include": "source.ocaml#attributes" },
    { "include": "source.ocaml#extensions" },
    { "include": "#bindings" },
    { "include": "source.ocaml#raw-identifiers" },
    { "include": "source.ocaml#operators" },
    { "include": "#keywords" },
    { "include": "source.ocaml#types" },
    { "include": "source.ocaml#identifiers" }
  ],
  "repository": {
    "bindings": {
      "comment": "bindings that are shared between .ml and .mli syntaxes",
      "patterns": [
        {
          "comment": "optional labeled argument",
          "name": "variable.parameter.optional.ocaml",
          "match": "\\?((?:\\\\#)?[[:lower:]_][[:word:]']*)"
        },
        {
          "comment": "labeled argument",
          "name": "variable.parameter.labeled.ocaml",
          "match": "~((?:\\\\#)?[[:lower:]_][[:word:]']*)"
        },
        { "include": "#type-declarations" },
        {
          "comment": "and declaration for let bindings, type declarations, class bindings, class type definitions, or module constraints",
          "match": "\\b(and)[[:space:]]+(?!(?:module|type|lazy)\\b(?!'))(virtual[[:space:]]+)?(_[[:space:]]+|'[[:alpha:]][[:word:]']*[[:space:]]+|\\(.*\\)[[:space:]]+)?((?:\\\\#)?[[:lower:]_][[:word:]']*)(?![[:word:]'])[[:space:]]*(?!,|::|[[:space:]])",
          "captures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "keyword.ocaml" },
            "3": {
              "patterns": [{ "include": "$base" }]
            },
            "4": { "name": "entity.name.binding.ocaml" }
          }
        },
        {
          "comment": "external declaration",
          "begin": "\\b(external)[[:space:]]+((?:\\\\#)?[[:lower:]_][[:word:]']*)?",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "entity.name.binding.ocaml" }
          },
          "end": "(?<=]|\")[[:space:]]*(?:$|(?=]))",
          "patterns": [
            {
              "comment": "string literal",
              "name": "string.quoted.double.ocaml",
              "begin": "\"",
              "end": "\""
            },
            { "include": "$base" }
          ]
        },
        {
          "comment": "val declaration for class instance variables",
          "match": "\\b(val)[[:space:]]+(virtual)[[:space:]]+(mutable)[[:space:]]+((?:\\\\#)?[[:lower:]_][[:word:]']*)",
          "captures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "keyword.ocaml" },
            "3": { "name": "keyword.ocaml" },
            "4": { "name": "entity.name.binding.ocaml" }
          }
        },
        {
          "comment": "val declaration for let bindings or class instance variables",
          "match": "\\b(val|val!)[[:space:]]+(mutable[[:space:]]+)?(virtual[[:space:]]+)?((?:\\\\#)?[[:lower:]_][[:word:]']*)",
          "captures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "keyword.ocaml" },
            "3": { "name": "keyword.ocaml" },
            "4": { "name": "entity.name.binding.ocaml" }
          }
        },
        {
          "comment": "class method declaration",
          "match": "\\b(method)[[:space:]]+(virtual)[[:space:]]+(private)[[:space:]]+((?:\\\\#)?[[:lower:]_][[:word:]']*)",
          "captures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "keyword.ocaml" },
            "3": { "name": "keyword.ocaml" },
            "4": { "name": "entity.name.function.method.ocaml" }
          }
        },
        {
          "comment": "class method declaration",
          "match": "\\b(method|method!)[[:space:]]+(private[[:space:]]+)?(virtual[[:space:]]+)?((?:\\\\#)?[[:lower:]_][[:word:]']*)",
          "captures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "keyword.ocaml" },
            "3": { "name": "keyword.ocaml" },
            "4": { "name": "entity.name.function.method.ocaml" }
          }
        },
        { "include": "#class-declarations" },
        {
          "comment": "named self in object",
          "match": "\\b(object)[[:space:]]*\\([[:space:]]*((?:\\\\#)?[[:lower:]_][[:word:]']*)",
          "captures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "variable.other.binding.ocaml" }
          }
        },
        {
          "comment": "module type of",
          "begin": "\\b(module)[[:space:]]+(type)[[:space:]]+(of)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "keyword.ocaml" },
            "3": { "name": "keyword.ocaml" }
          },
          "end": "(?=val|external|type|exception|class|module|open|include|=)",
          "patterns": [{ "include": "source.ocaml" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "reserved ocaml keyword (in interfaces)",
          "name": "keyword.other.ocaml.interface",
          "match": "\\b(and|as|class|constraint|end|exception|external|functor|in|include|inherit|let[[:space:]]+open|method|module|mutable|nonrec|object|of|open|private|rec|sig|type|val|virtual|with)\\b(?!')"
        }
      ]
    },
    "type-declarations": {
      "begin": "(?=\\btype\\b(?!'))",
      "end": "(?=\\b(?:let|val|external|exception|module|open|include|end|in)\\b(?!')|;;|[)}\\]]|\\bclass\\b(?!')|\\band[[:space:]]+module\\b(?!'))",
      "patterns": [
        {
          "begin": "\\b(type|and)\\b(?!')",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "end": "((?:\\\\#)?[[:lower:]_][[:word:]']*)|(?=[[:upper:]]|[=;)}\\]])",
          "endCaptures": {
            "1": { "name": "entity.name.type.ocaml" }
          },
          "applyEndPatternLast": true,
          "patterns": [
            {
              "match": "(%)([[:alpha:]_][[:word:]']*(?:\\.[[:alpha:]_][[:word:]']*)*)",
              "captures": {
                "1": { "name": "keyword.operator.extension.ocaml" },
                "2": { "name": "keyword.other.extension.ocaml" }
              }
            },
            {
              "match": "\\b(nonrec|type)\\b(?!')",
              "name": "keyword.ocaml"
            },
            {
              "match": "_[[:space:]]+(?=(?:\\\\#)?[[:lower:]_][[:word:]']*)",
              "name": "storage.type.ocaml"
            },
            { "include": "source.ocaml#comments" },
            { "include": "source.ocaml#attributes" },
            { "include": "source.ocaml#extensions" },
            { "match": "[+!-]", "name": "keyword.operator.ocaml" },
            { "include": "source.ocaml#types" },
            { "include": "#declaration-delimiters" }
          ]
        },
        { "include": "#declaration-body" }
      ]
    },
    "class-declarations": {
      "begin": "(?=\\bclass\\b(?!'))",
      "end": "(?=\\b(?:let|val|external|exception|module|open|include|end|in)\\b(?!')|;;|[)}\\]]|\\btype\\b(?!')|\\band[[:space:]]+(?:type|module)\\b(?!'))",
      "patterns": [
        {
          "begin": "\\b(class|and)\\b(?!')",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "end": "((?:\\\\#)?[[:lower:]_][[:word:]']*)|(?=[[:upper:]]|[=;)}\\]])",
          "endCaptures": {
            "1": { "name": "entity.name.type.class.ocaml" }
          },
          "applyEndPatternLast": true,
          "patterns": [
            {
              "match": "(%)([[:alpha:]_][[:word:]']*(?:\\.[[:alpha:]_][[:word:]']*)*)",
              "captures": {
                "1": { "name": "keyword.operator.extension.ocaml" },
                "2": { "name": "keyword.other.extension.ocaml" }
              }
            },
            {
              "match": "\\b(type|virtual)\\b(?!')",
              "name": "keyword.ocaml"
            },
            { "include": "source.ocaml#comments" },
            { "include": "source.ocaml#attributes" },
            { "include": "source.ocaml#extensions" },
            { "include": "source.ocaml#types" },
            { "include": "#declaration-delimiters" }
          ]
        },
        { "include": "#class-expression-prefix" },
        { "include": "#declaration-body" }
      ]
    },
    "declaration-delimiters": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [{ "include": "#declaration-body" }]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [{ "include": "#declaration-body" }]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "#declaration-body" }]
        }
      ]
    },
    "class-expression-prefix": {
      "begin": "=",
      "beginCaptures": {
        "0": { "name": "keyword.operator.ocaml" }
      },
      "end": "(?=[^ \\t\\r\\n\\f])",
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "source.ocaml#comments" },
        { "include": "source.ocaml#attributes" },
        { "include": "#class-local-let" },
        {
          "begin": "\\b(fun)\\b(?!')",
          "end": "->",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "endCaptures": {
            "0": { "name": "keyword.operator.ocaml" }
          },
          "patterns": [{ "include": "#declaration-body" }]
        }
      ]
    },
    "class-local-let": {
      "patterns": [
        {
          "begin": "\\b(let)[[:space:]]+(?!(?:lazy|open)\\b(?!'))(rec[[:space:]]+)?(?!rec\\b(?!'))((?:\\\\#)?[[:lower:]_][[:word:]']*)(?![[:word:]'])[[:space:]]*(?!,|::|[[:space:]])",
          "end": "\\b(in)\\b(?!')",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "keyword.ocaml" },
            "3": { "name": "entity.name.binding.ocaml" }
          },
          "endCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "patterns": [{ "include": "#class-local-let" }, { "include": "#declaration-body" }]
        },
        {
          "begin": "\\b(let)\\b(?!')",
          "end": "\\b(in)\\b(?!')",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "endCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "patterns": [{ "include": "#class-local-let" }, { "include": "#declaration-body" }]
        }
      ]
    },
    "declaration-blocks": {
      "patterns": [
        {
          "begin": "\\b(object)\\b(?!')(?:[[:space:]]*\\([[:space:]]*((?:\\\\#)?[[:lower:]_][[:word:]']*))?",
          "end": "\\b(end)\\b(?!')",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" },
            "2": { "name": "variable.other.binding.ocaml" }
          },
          "endCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "patterns": [{ "include": "#declaration-body" }]
        },
        {
          "begin": "\\b(begin|struct)\\b(?!')",
          "end": "\\b(end)\\b(?!')",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "endCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "patterns": [{ "include": "#declaration-body" }]
        },
        {
          "begin": "\\b(sig)\\b(?!')",
          "end": "\\b(end)\\b(?!')",
          "beginCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "endCaptures": {
            "1": { "name": "keyword.ocaml" }
          },
          "patterns": [
            { "include": "#declaration-lexical" },
            { "include": "#declaration-blocks" },
            { "include": "source.ocaml.interface" },
            { "include": "#declaration-delimiters" }
          ]
        }
      ]
    },
    "declaration-body": {
      "patterns": [
        { "include": "#declaration-lexical" },
        { "include": "#declaration-blocks" },
        { "include": "$base" },
        { "include": "#declaration-delimiters" }
      ]
    },
    "declaration-lexical": {
      "patterns": [
        { "include": "source.ocaml#comments" },
        { "include": "source.ocaml#strings" },
        { "include": "source.ocaml#characters" },
        { "include": "source.ocaml#attributes" },
        { "include": "source.ocaml#extensions" },
        { "include": "source.ocaml#raw-identifiers" }
      ]
    }
  }
}
