[
  {
    "name": "opam identifiers do not split at literal prefixes",
    "scope": "source.ocaml.opam",
    "reference": "https://github.com/ocaml/opam-file-format/blob/2.2.0/src/opamLexer.mll",
    "source": "available: [true-value false+pkg 123pkg 123-pkg -123pkg pkg:true true:installed]",
    "assertions": [
      {
        "line": 1,
        "text": "true-value",
        "scopes": ["variable.parameter.opam"],
        "notScopes": ["constant"],
        "singleToken": true
      },
      {
        "line": 1,
        "text": "false+pkg",
        "scopes": ["variable.parameter.opam"],
        "notScopes": ["constant"],
        "singleToken": true
      },
      {
        "line": 1,
        "text": "123pkg",
        "scopes": ["variable.parameter.opam"],
        "notScopes": ["constant"],
        "singleToken": true
      },
      {
        "line": 1,
        "text": "123-pkg",
        "scopes": ["variable.parameter.opam"],
        "notScopes": ["constant"],
        "singleToken": true
      },
      {
        "line": 1,
        "text": "-123pkg",
        "scopes": ["variable.parameter.opam"],
        "notScopes": ["constant"],
        "singleToken": true
      },
      {
        "line": 1,
        "text": "pkg:true",
        "scopes": ["variable.parameter.opam"],
        "notScopes": ["constant"],
        "singleToken": true
      },
      {
        "line": 1,
        "text": "true:installed",
        "scopes": ["variable.parameter.opam"],
        "notScopes": ["constant"],
        "singleToken": true
      }
    ]
  },
  {
    "name": "opam complete boolean and integer literals",
    "scope": "source.ocaml.opam",
    "reference": "https://github.com/ocaml/opam-file-format/blob/2.2.0/src/opamLexer.mll",
    "source": "available: [true false 123 -123 1_000]\nx-enabled:true\nx-count:-123",
    "assertions": [
      { "line": 1, "text": "true", "scopes": ["constant.language.opam"], "singleToken": true },
      { "line": 1, "text": "false", "scopes": ["constant.language.opam"], "singleToken": true },
      {
        "line": 1,
        "text": "123",
        "scopes": ["constant.numeric.decimal.opam"],
        "singleToken": true
      },
      {
        "line": 1,
        "text": "-123",
        "scopes": ["constant.numeric.decimal.opam"],
        "singleToken": true
      },
      {
        "line": 1,
        "text": "1_000",
        "scopes": ["constant.numeric.decimal.opam"],
        "singleToken": true
      },
      { "line": 2, "text": "true", "scopes": ["constant.language.opam"], "singleToken": true },
      {
        "line": 3,
        "text": "-123",
        "scopes": ["constant.numeric.decimal.opam"],
        "singleToken": true
      }
    ]
  }
]
