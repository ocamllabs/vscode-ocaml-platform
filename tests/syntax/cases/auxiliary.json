[
  {
    "name": "opam triple strings protect quotes and comment markers",
    "scope": "source.ocaml.opam",
    "source": "description: \"\"\"\nUse \"quotes\" and # text\n\"\"\"\nsynopsis: \"done\"",
    "assertions": [
      {
        "line": 2,
        "text": "quotes",
        "scopes": ["string.quoted.triple-double.opam"]
      },
      {
        "line": 2,
        "text": "# text",
        "scopes": ["string.quoted.triple-double.opam"],
        "notScopes": ["comment"]
      },
      {
        "line": 4,
        "text": "synopsis",
        "scopes": ["entity.name.tag.opam"],
        "notScopes": ["string"]
      }
    ],
    "reference": "https://opam.ocaml.org/doc/Manual.html"
  },
  {
    "name": "opam indented fields and strings",
    "scope": "source.ocaml.opam",
    "source": "url {\n  src: \"https://example.org/archive\"\n}\nx+field: -42",
    "assertions": [
      {
        "line": 2,
        "text": "src",
        "scopes": ["entity.name.tag.opam"]
      },
      {
        "line": 4,
        "text": "x+field",
        "scopes": ["entity.name.tag.opam"],
        "singleToken": true
      },
      {
        "line": 4,
        "text": "-42",
        "scopes": ["constant.numeric.decimal.opam"],
        "singleToken": true
      }
    ],
    "reference": "https://opam.ocaml.org/doc/Manual.html"
  },
  {
    "name": "opam install escaped quote protects comment marker",
    "scope": "source.ocaml.opam-install",
    "source": "lib: [\"a\\\"#b\"] # end\nbin: [\"tool\"]",
    "assertions": [
      {
        "line": 1,
        "text": "#b",
        "scopes": ["string.quoted.double.opam-install"],
        "notScopes": ["comment"]
      },
      {
        "line": 1,
        "text": "# end",
        "scopes": ["comment.line.opam-install"]
      },
      {
        "line": 2,
        "text": "bin",
        "scopes": ["entity.name.tag.opam-install"]
      }
    ],
    "reference": "https://opam.ocaml.org/doc/Manual.html"
  },
  {
    "name": "META consecutive and multiline assignments",
    "scope": "source.ocaml.META",
    "source": "version = \"1\" description = \"line one\nline two \\\"quoted\\\" # text\"\narchive(byte) = \"a.cma\" # done",
    "assertions": [
      {
        "line": 1,
        "text": "description",
        "scopes": ["entity.name.tag.META"],
        "notScopes": ["string"]
      },
      {
        "line": 2,
        "text": "# text",
        "scopes": ["string.quoted.double.META"],
        "notScopes": ["comment"]
      },
      {
        "line": 3,
        "text": "byte",
        "scopes": ["constant.language.META"]
      },
      {
        "line": 3,
        "text": "# done",
        "scopes": ["comment.line.META"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/ocaml/ocamlfind/master/src/findlib/fl_meta.mll"
  },
  {
    "name": "ATD single quoted annotation string and type parameter",
    "scope": "source.atd",
    "source": "type 'a item = 'a list <doc text='a > b \\' c'>\ntype next = int",
    "assertions": [
      {
        "line": 1,
        "text": "a > b",
        "scopes": ["string.quoted.single.atd"]
      },
      {
        "line": 1,
        "text": "list",
        "notScopes": ["support.type"]
      },
      {
        "line": 2,
        "text": "next",
        "scopes": ["entity.name.type.atd"],
        "notScopes": ["string"]
      }
    ],
    "reference": "https://atd.readthedocs.io/en/latest/atd-language.html"
  },
  {
    "name": "ATD import declarations",
    "scope": "source.atd",
    "source": "from mylib.common as c import date, timestamp\ntype event = c.date",
    "assertions": [
      {
        "line": 1,
        "text": "from",
        "scopes": ["keyword.other.atd"]
      },
      {
        "line": 1,
        "text": "as",
        "scopes": ["keyword.other.atd"]
      },
      {
        "line": 1,
        "text": "import",
        "scopes": ["keyword.other.atd"]
      },
      {
        "line": 2,
        "text": "event",
        "scopes": ["entity.name.type.atd"]
      }
    ],
    "reference": "https://atd.readthedocs.io/en/latest/atd-language.html"
  },
  {
    "name": "Merlin hidden dependency and index paths",
    "scope": "source.ocaml.merlin",
    "source": "SH src/**\nBH _build/default\nINDEX _build/**/*.ocaml-index\nPKG lwt.unix",
    "assertions": [
      {
        "line": 1,
        "text": "SH",
        "scopes": ["keyword.other.merlin"]
      },
      {
        "line": 2,
        "text": "BH",
        "scopes": ["keyword.other.merlin"]
      },
      {
        "line": 3,
        "text": "INDEX",
        "scopes": ["keyword.other.merlin"]
      },
      {
        "line": 4,
        "text": "lwt",
        "scopes": ["entity.name.class.merlin"]
      }
    ],
    "reference": "https://github.com/ocaml/merlin/wiki/Project-configuration"
  },
  {
    "name": "Menhir declarations rules and semantic action injection",
    "scope": "source.ocaml.menhir",
    "source": "%token <int> INT\n%start <int> main\n%%\nmain: x = INT { $startpos(x), x }\nlet other == INT; < Fun.id >",
    "assertions": [
      {
        "line": 1,
        "text": "%token",
        "scopes": ["keyword.other.menhir"]
      },
      {
        "line": 1,
        "text": "INT",
        "scopes": ["constant.other.token.menhir"]
      },
      {
        "line": 4,
        "text": "$startpos",
        "scopes": ["keyword.other.menhir"]
      },
      {
        "line": 5,
        "text": "other",
        "scopes": ["entity.name.function.rule.menhir"]
      }
    ],
    "reference": "https://gallium.inria.fr/~fpottier/menhir/manual.html"
  },
  {
    "name": "Menhir position keyword variants",
    "scope": "source.action.menhir",
    "source": "$symbolstartpos $sloc $startofs($1) $endpos(token)",
    "assertions": [
      {
        "line": 1,
        "text": "$symbolstartpos",
        "scopes": ["keyword.other.menhir"]
      },
      {
        "line": 1,
        "text": "$sloc",
        "scopes": ["keyword.other.menhir"]
      },
      {
        "line": 1,
        "text": "$1",
        "scopes": ["keyword.other.menhir"]
      }
    ],
    "reference": "https://gallium.inria.fr/~fpottier/menhir/manual.html"
  },
  {
    "name": "OCamlFormat basic config",
    "scope": "source.ocaml.ocamlformat",
    "source": "profile = conventional\nmargin = 90 # width",
    "assertions": [
      {
        "line": 1,
        "text": "profile",
        "scopes": ["keyword.other.ocamlformat"]
      },
      {
        "line": 1,
        "text": "conventional",
        "scopes": ["string.other.ocamlformat"]
      },
      {
        "line": 2,
        "text": "90",
        "scopes": ["constant.numeric.decimal.ocamlformat"]
      },
      {
        "line": 2,
        "text": "# width",
        "scopes": ["comment.line.ocamlformat"]
      }
    ],
    "reference": "https://ocaml.org/p/ocamlformat/latest/doc/getting_started.html"
  },
  {
    "name": "OASIS sections and fields",
    "scope": "source.ocaml.oasis",
    "source": "Library core\n  Path: src\n  if flag(debug)\n    Build$: true",
    "assertions": [
      {
        "line": 1,
        "text": "Library",
        "scopes": ["keyword.other.oasis"]
      },
      {
        "line": 2,
        "text": "Path",
        "scopes": ["entity.name.tag.oasis"]
      },
      {
        "line": 3,
        "text": "flag",
        "scopes": ["entity.name.function.oasis"]
      },
      {
        "line": 4,
        "text": "true",
        "scopes": ["constant.language.oasis"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/ocaml/oasis/master/doc/MANUAL.mkd"
  },
  {
    "name": "OCamlbuild glob expressions",
    "scope": "source.ocaml.ocamlbuild",
    "source": "<src/*.ml> or <test/?.ml>: debug, bin_annot # done",
    "assertions": [
      {
        "line": 1,
        "text": "*",
        "scopes": ["constant.language.ocamlbuild"]
      },
      {
        "line": 1,
        "text": "or",
        "scopes": ["keyword.operator.ocamlbuild"]
      },
      {
        "line": 1,
        "text": "?",
        "scopes": ["keyword.operator.ocamlbuild"]
      },
      {
        "line": 1,
        "text": "# done",
        "scopes": ["comment.line.ocamlbuild"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/ocaml/ocamlbuild/master/src/glob_lexer.mll"
  },
  {
    "name": "Reason nested comments raw strings and recovery",
    "scope": "source.reason",
    "source": "/* outer /* inner */ still outer */\nlet text = {tag|\" /* raw */ |other} |tag};\nlet next = 42;",
    "assertions": [
      {
        "line": 1,
        "text": "still outer",
        "scopes": ["comment.block"]
      },
      {
        "line": 2,
        "text": "/* raw */",
        "scopes": ["string.double"],
        "notScopes": ["comment"]
      },
      {
        "line": 3,
        "text": "42",
        "scopes": ["constant.numeric"],
        "notScopes": ["string"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/reasonml/reason/master/src/reason-parser/reason_declarative_lexer.mll"
  },
  {
    "name": "Reason external string escapes",
    "scope": "source.reason",
    "source": "external f: string => string = \"a\\\"#b\";\nlet next = 42;",
    "assertions": [
      {
        "line": 1,
        "text": "#b",
        "scopes": ["string.double"]
      },
      {
        "line": 2,
        "text": "42",
        "scopes": ["constant.numeric"],
        "notScopes": ["string"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/reasonml/reason/master/src/reason-parser/reason_declarative_lexer.mll"
  },
  {
    "name": "Reason Markdown fence embeds source",
    "scope": "markdown.reason.codeblock",
    "source": "```reason\nlet next = 42;\n```\nafter",
    "assertions": [
      {
        "line": 2,
        "text": "42",
        "scopes": ["constant.numeric"]
      },
      {
        "line": 4,
        "text": "after",
        "notScopes": ["meta.embedded.block.reason"]
      }
    ],
    "reference": "https://spec.commonmark.org/0.31.2/#fenced-code-blocks"
  },
  {
    "name": "Menhir action injection excludes comments and strings",
    "scope": "source.ocaml.menhir",
    "source": "%token INT\n%%\nmain: INT { ($startpos, $1); \"$startpos\"; {| $1 |}; (* $endpos *) $endpos }\n%%\nlet plain = \"$startpos\"",
    "assertions": [
      {
        "line": 3,
        "text": "$startpos",
        "scopes": ["keyword.other.menhir"]
      },
      {
        "line": 3,
        "text": "$1",
        "scopes": ["keyword.other.menhir"]
      },
      {
        "line": 3,
        "text": "$startpos",
        "occurrence": 2,
        "notScopes": ["keyword.other.menhir"]
      },
      {
        "line": 3,
        "text": "$1",
        "occurrence": 2,
        "notScopes": ["keyword.other.menhir"]
      },
      {
        "line": 3,
        "text": "$endpos",
        "notScopes": ["keyword.other.menhir"]
      },
      {
        "line": 3,
        "text": "$endpos",
        "occurrence": 2,
        "scopes": ["keyword.other.menhir"]
      },
      {
        "line": 5,
        "text": "$startpos",
        "notScopes": ["keyword.other.menhir"]
      }
    ],
    "reference": "https://gallium.inria.fr/~fpottier/menhir/manual.html"
  },
  {
    "name": "Reason longer Markdown closing fence",
    "scope": "markdown.reason.codeblock",
    "source": "```reason\nlet x = 1;\n````\nafter",
    "assertions": [
      {
        "line": 4,
        "text": "after",
        "notScopes": ["markup.fenced_code.block.markdown", "meta.embedded.block.reason"]
      }
    ],
    "reference": "https://spec.commonmark.org/0.31.2/#fenced-code-blocks"
  },
  {
    "name": "OASIS hash in field value",
    "scope": "source.ocaml.oasis",
    "source": "Homepage: https://example.org/#section\n# comment",
    "assertions": [
      {
        "line": 1,
        "text": "#section",
        "notScopes": ["comment"]
      },
      {
        "line": 2,
        "text": "# comment",
        "scopes": ["comment.line.oasis"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/ocaml/oasis/master/doc/MANUAL.mkd"
  },
  {
    "name": "Reason strings inside comments protect closing delimiters",
    "scope": "source.reason",
    "source": "/* \"*/\" still comment {tag| */ |tag} remains */\n/** \"*/\" documentation */\nlet next = 42;",
    "assertions": [
      {
        "line": 1,
        "text": "still comment",
        "scopes": ["comment.block"]
      },
      {
        "line": 1,
        "text": "remains",
        "scopes": ["comment.block"]
      },
      {
        "line": 2,
        "text": "documentation",
        "scopes": ["comment.block.documentation"]
      },
      {
        "line": 3,
        "text": "42",
        "scopes": ["constant.numeric"],
        "notScopes": ["comment"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/reasonml/reason/master/src/reason-parser/reason_declarative_lexer.mll"
  },
  {
    "name": "Reason Unicode escape",
    "scope": "source.reason",
    "source": "let x = \"\\u{1F42B}\";",
    "assertions": [
      {
        "line": 1,
        "text": "\\u{1F42B}",
        "scopes": ["constant.character"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/reasonml/reason/master/src/reason-parser/reason_declarative_lexer.mll"
  },
  {
    "name": "OCamlbuild escaped quote and boolean alternatives",
    "scope": "source.ocaml.ocamlbuild",
    "source": "\"a\\\"#b.ml\" OR <*.ml> & NOT <test/*>: debug\n1: bin_annot",
    "assertions": [
      {
        "line": 1,
        "text": "#b.ml",
        "scopes": ["string.quoted.double.ocamlbuild"],
        "notScopes": ["comment"]
      },
      {
        "line": 1,
        "text": "OR",
        "scopes": ["keyword.operator.ocamlbuild"]
      },
      {
        "line": 1,
        "text": "&",
        "scopes": ["keyword.operator.ocamlbuild"]
      },
      {
        "line": 1,
        "text": "NOT",
        "scopes": ["keyword.operator.ocamlbuild"]
      },
      {
        "line": 2,
        "text": "1",
        "scopes": ["constant.language.ocamlbuild"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/ocaml/ocamlbuild/master/src/glob_lexer.mll"
  },
  {
    "name": "META nested package entry boundaries",
    "scope": "source.ocaml.META",
    "source": "package \"one\" (version = \"1\") package \"two\" (version = \"2\")",
    "assertions": [
      {
        "line": 1,
        "text": "version",
        "scopes": ["entity.name.tag.META"],
        "notScopes": ["string"]
      },
      {
        "line": 1,
        "text": "version",
        "occurrence": 2,
        "scopes": ["entity.name.tag.META"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/ocaml/ocamlfind/master/src/findlib/fl_meta.mll"
  },
  {
    "name": "Reason comment character quote",
    "scope": "source.reason",
    "source": "/* a quote character: '\"' */\nlet next = 42;",
    "assertions": [
      {
        "line": 2,
        "text": "42",
        "scopes": ["constant.numeric"],
        "notScopes": ["comment"]
      }
    ],
    "reference": "https://raw.githubusercontent.com/reasonml/reason/master/src/reason-parser/reason_declarative_lexer.mll"
  },
  {
    "name": "Reason Markdown rejects short and wrong closing fences",
    "scope": "markdown.reason.codeblock",
    "source": "````reason attrs\nlet x = 1;\n```\nlet y = 2;\n~~~~\nlet z = 3;\n`````\nafter",
    "assertions": [
      {
        "line": 1,
        "text": "reason",
        "scopes": ["fenced_code.block.language.markdown"]
      },
      {
        "line": 1,
        "text": "attrs",
        "scopes": ["fenced_code.block.language.attributes.markdown"]
      },
      {
        "line": 4,
        "text": "2",
        "scopes": ["constant.numeric"]
      },
      {
        "line": 6,
        "text": "3",
        "scopes": ["constant.numeric"]
      },
      {
        "line": 8,
        "text": "after",
        "notScopes": ["markup.fenced_code.block.markdown"]
      }
    ],
    "reference": "https://spec.commonmark.org/0.31.2/#fenced-code-blocks"
  },
  {
    "name": "ATD type names and fields remain identifiers",
    "scope": "source.atd",
    "source": "type list' = int\ntype foo = list'\ntype item = { list: int; string: string }\ntype 'ab' wrap_value = 'ab' list",
    "assertions": [
      {
        "line": 1,
        "text": "list'",
        "scopes": ["entity.name.type.atd"],
        "notScopes": ["support.type"],
        "singleToken": true
      },
      {
        "line": 2,
        "text": "list'",
        "notScopes": ["support.type"],
        "singleToken": true
      },
      {
        "line": 3,
        "text": "list",
        "notScopes": ["support.type"]
      },
      {
        "line": 3,
        "text": "int",
        "notScopes": ["support.type"]
      },
      {
        "line": 3,
        "text": "string",
        "notScopes": ["support.type"]
      },
      {
        "line": 3,
        "text": "string",
        "occurrence": 2,
        "notScopes": ["support.type"]
      },
      {
        "line": 4,
        "text": "'ab'",
        "scopes": ["storage.type.ocaml.atd"],
        "singleToken": true
      },
      {
        "line": 4,
        "text": "'ab'",
        "occurrence": 2,
        "scopes": ["storage.type.ocaml.atd"],
        "singleToken": true
      }
    ],
    "reference": "https://github.com/ahrefs/atd/blob/4.2.0/atd/src/lexer.mll#L112"
  },
  {
    "name": "Declaration roles source.atd",
    "scope": "source.atd",
    "source": "type item = int\ntype 'a wrapper = 'a list",
    "reference": "https://atd.readthedocs.io/en/latest/atd-language.html",
    "assertions": [
      {
        "line": 1,
        "text": "item",
        "scopes": ["entity.name.type.atd"],
        "notScopes": ["entity.name.function"],
        "singleToken": true
      },
      {
        "line": 2,
        "text": "wrapper",
        "scopes": ["entity.name.type.atd"],
        "notScopes": ["entity.name.function"],
        "singleToken": true
      }
    ]
  }
]
