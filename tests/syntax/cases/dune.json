[
  {
    "name": "Dune stanza atoms have complete boundaries",
    "scope": "source.dune",
    "source": "(library-extra (name foo))\n(library (name foo))",
    "assertions": [
      {
        "line": 1,
        "text": "library",
        "notScopes": ["keyword.language"]
      },
      {
        "line": 2,
        "text": "library",
        "scopes": ["keyword.language.dune"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/lexical-conventions.html"
  },
  {
    "name": "Dune constants do not split user atoms",
    "scope": "source.dune",
    "source": "(rule (action (echo true-value foo.1.2 path/to :standard-extra)))",
    "assertions": [
      {
        "line": 1,
        "text": "true",
        "notScopes": ["constant.language"]
      },
      {
        "line": 1,
        "text": "1.2",
        "notScopes": ["constant.numeric"]
      },
      {
        "line": 1,
        "text": "/",
        "notScopes": ["keyword.operator"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/lexical-conventions.html"
  },
  {
    "name": "Dune quoted interpolation and literal percent escape",
    "scope": "source.dune",
    "source": "(rule (action (echo \"%{profile} \\%{literal} \\%\")))",
    "assertions": [
      {
        "line": 1,
        "text": "%{",
        "scopes": ["keyword.operator.dune"],
        "notScopes": ["constant.character.escape"]
      },
      {
        "line": 1,
        "text": "profile",
        "scopes": ["constant.language.variable.dune"]
      },
      {
        "line": 1,
        "text": "\\%",
        "scopes": ["constant.character.escape.dune"]
      },
      {
        "line": 1,
        "text": "literal",
        "notScopes": ["constant.character.escape", "constant.language.variable"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/lexical-conventions.html"
  },
  {
    "name": "Dune multiline strings distinguish raw and escaped text",
    "scope": "source.dune",
    "source": "(rule (action (echo\n  \"\\| %{profile} \\n\n  \"\\> %{profile} \\n\n)))\n(library (name next))",
    "assertions": [
      {
        "line": 2,
        "text": "profile",
        "scopes": ["constant.language.variable.dune"]
      },
      {
        "line": 2,
        "text": "\\n",
        "scopes": ["constant.character.escape.dune"]
      },
      {
        "line": 3,
        "text": "profile",
        "scopes": ["string.quoted.line.dune"],
        "notScopes": ["constant.language.variable"]
      },
      {
        "line": 5,
        "text": "library",
        "scopes": ["keyword.language.dune"],
        "notScopes": ["string"]
      },
      {
        "line": 2,
        "text": "%{",
        "scopes": ["keyword.operator.dune"],
        "notScopes": ["constant.character.escape"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/lexical-conventions.html"
  },
  {
    "name": "Dune ordered sets use backslash subtraction",
    "scope": "source.dune",
    "source": "(library (modules (:standard \\ Main)))",
    "assertions": [
      {
        "line": 1,
        "text": "\\",
        "scopes": ["keyword.operator.dune"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/actions/index.html"
  },
  {
    "name": "Dune punctuated actions remain complete tokens",
    "scope": "source.dune",
    "source": "(rule (action (progn (copy# a b) (diff? a b))))",
    "assertions": [
      {
        "line": 1,
        "text": "copy#",
        "scopes": ["entity.name.function.action.dune"],
        "singleToken": true
      },
      {
        "line": 1,
        "text": "diff?",
        "scopes": ["entity.name.function.action.dune"],
        "singleToken": true
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/actions/index.html"
  },
  {
    "name": "Dune supported action names",
    "scope": "source.dune",
    "source": "(rule (action (concurrent (ignore-stderr (dynamic-run ./a.exe)) (format-dune-file a b))))",
    "assertions": [
      {
        "line": 1,
        "text": "concurrent",
        "scopes": ["entity.name.function.action.dune"]
      },
      {
        "line": 1,
        "text": "ignore-stderr",
        "scopes": ["entity.name.function.action.dune"]
      },
      {
        "line": 1,
        "text": "dynamic-run",
        "scopes": ["entity.name.function.action.dune"]
      },
      {
        "line": 1,
        "text": "format-dune-file",
        "scopes": ["entity.name.function.action.dune"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/actions/index.html"
  },
  {
    "name": "Dune files stanza introduced in 3.21",
    "scope": "source.dune",
    "source": "(files :standard \\ *.cm*)",
    "assertions": [
      {
        "line": 1,
        "text": "files",
        "scopes": ["keyword.language.dune"]
      },
      {
        "line": 1,
        "text": "\\",
        "scopes": ["keyword.operator.dune"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/dune/files.html"
  },
  {
    "name": "Dune project fields respect atom boundaries",
    "scope": "source.dune-project",
    "source": "(name-extra foo)\n(name foo)\n(version 12.34)",
    "assertions": [
      {
        "line": 1,
        "text": "name",
        "notScopes": ["keyword.language"]
      },
      {
        "line": 2,
        "text": "name",
        "scopes": ["keyword.language.dune-project"]
      },
      {
        "line": 3,
        "text": "12.34",
        "scopes": ["constant.numeric.dune"],
        "singleToken": true
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/lexical-conventions.html"
  },
  {
    "name": "Dune workspace pkg toggle introduced in 3.20",
    "scope": "source.dune-workspace",
    "source": "(pkg enabled)\n(profile-extra dev)\n(profile dev)",
    "assertions": [
      {
        "line": 1,
        "text": "pkg",
        "scopes": ["keyword.language.dune-workspace"]
      },
      {
        "line": 1,
        "text": "enabled",
        "scopes": ["constant.language.dune-workspace"]
      },
      {
        "line": 2,
        "text": "profile",
        "notScopes": ["keyword.language"]
      },
      {
        "line": 3,
        "text": "profile",
        "scopes": ["keyword.language.dune-workspace"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/dune-workspace/pkg.html"
  },
  {
    "name": "Cram nonzero status is a numeric result",
    "scope": "source.cram",
    "source": "  $ false\n  [1]\n  output [1]",
    "assertions": [
      {
        "line": 2,
        "text": "1",
        "scopes": ["constant.numeric.cram"]
      },
      {
        "line": 3,
        "text": "1",
        "scopes": ["string.other.cram"],
        "notScopes": ["constant.numeric"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/cram.html"
  },
  {
    "name": "Cram single quotes preserve backslashes",
    "scope": "source.cram",
    "source": "  $ printf '%s' '\\n'",
    "assertions": [
      {
        "line": 1,
        "text": "\\n",
        "scopes": ["string.quoted.single.cram"],
        "notScopes": ["constant.character.escape"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/cram.html"
  },
  {
    "name": "Dune comments and quoted delimiters retain lexical state",
    "scope": "source.dune",
    "source": "(library ; (fake) \"\n (name \"foo;bar\"))\n(library (name next))",
    "assertions": [
      {
        "line": 1,
        "text": "(fake)",
        "scopes": ["comment.line.dune"]
      },
      {
        "line": 2,
        "text": ";",
        "scopes": ["string.quoted.double.dune"],
        "notScopes": ["comment"]
      },
      {
        "line": 3,
        "text": "library",
        "scopes": ["keyword.language.dune"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/lexical-conventions.html"
  },
  {
    "name": "Dune workspace shared quoted interpolation",
    "scope": "source.dune-workspace",
    "source": "(env (_ (flags \"%{profile}\")))",
    "assertions": [
      {
        "line": 1,
        "text": "profile",
        "scopes": ["constant.language.variable.dune"],
        "notScopes": ["constant.character.escape"]
      }
    ],
    "reference": "https://github.com/ocaml/dune/blob/3.24.2/src/dune_sexp/lexer.mll"
  },
  {
    "name": "Dune exact boolean and numeric atoms remain highlighted",
    "scope": "source.dune",
    "source": "(library (enabled_if true) (flags 12.34))",
    "assertions": [
      {
        "line": 1,
        "text": "true",
        "scopes": ["constant.language.dune"]
      },
      {
        "line": 1,
        "text": "12.34",
        "scopes": ["constant.numeric.dune"],
        "singleToken": true
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/boolean-language.html"
  },
  {
    "name": "Dune new stanza and value names require complete atoms",
    "scope": "source.dune-workspace",
    "source": "(pkg-extra enabled)\n(pkg enabled-extra)",
    "assertions": [
      {
        "line": 1,
        "text": "pkg",
        "notScopes": ["keyword.language"]
      },
      {
        "line": 2,
        "text": "enabled",
        "notScopes": ["constant.language"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/dune-workspace/pkg.html"
  },
  {
    "name": "Dune files stanza does not match longer atoms",
    "scope": "source.dune",
    "source": "(files-extra :standard)",
    "assertions": [
      {
        "line": 1,
        "text": "files",
        "notScopes": ["keyword.language"]
      }
    ],
    "reference": "https://dune.readthedocs.io/en/stable/reference/dune/files.html"
  },
  {
    "name": "Dune atom boundaries do not treat Unicode spaces as delimiters",
    "scope": "source.dune",
    "source": "(library (name a))\n(library (name a))\n(rule (action (echo true value 1.2 suffix)))",
    "assertions": [
      {
        "line": 1,
        "text": "library",
        "notScopes": ["keyword.language"]
      },
      {
        "line": 2,
        "text": "library",
        "notScopes": ["keyword.language"]
      },
      {
        "line": 3,
        "text": "true",
        "notScopes": ["constant.language"]
      },
      {
        "line": 3,
        "text": "1.2",
        "notScopes": ["constant.numeric"]
      }
    ],
    "reference": "https://github.com/ocaml/dune/blob/3.24.2/src/dune_sexp/lexer.mll"
  },
  {
    "name": "Dune atom boundaries retain tab and form-feed separators",
    "scope": "source.dune",
    "source": "(library\t(name a))\n(library\f(name b))",
    "assertions": [
      {
        "line": 1,
        "text": "library",
        "scopes": ["keyword.language.dune"]
      },
      {
        "line": 2,
        "text": "library",
        "scopes": ["keyword.language.dune"]
      }
    ],
    "reference": "https://github.com/ocaml/dune/blob/3.24.2/src/dune_sexp/lexer.mll"
  }
]
